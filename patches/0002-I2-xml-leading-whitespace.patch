+UNIT_TEST(Gpx_LeadingWhitespace_Test)
+{
+  // https://codeberg.org/comaps/comaps/issues/3963: files saved from web pages often start with a blank line.
+  std::string_view constexpr gpx = R"(<?xml version="1.0" encoding="UTF-8"?>
+<gpx version="1.1" creator="test" xmlns="http://www.topografix.com/GPX/1/1">
+ <wpt lat="54.68" lon="25.28"><name>Vilnius</name></wpt>
+ <trk><name>Track</name><trkseg><trkpt lat="54.0" lon="25.0"/><trkpt lat="54.1" lon="25.1"/></trkseg></trk>
+</gpx>)";
+  kml::FileData const expected = LoadGpxFromString(gpx);
+  TEST_EQUAL(expected.m_bookmarksData.size(), 1, ());
+  TEST_EQUAL(expected.m_tracksData.size(), 1, ());
+
+  for (std::string_view prefix : {"\n", "\r\n", "  \t\n  ", "\xEF\xBB\xBF", "\xEF\xBB\xBF\n", "\n\xEF\xBB\xBF", "\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n"
+                                  "\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n"})
+  {
+    std::string const content = std::string(prefix) + std::string(gpx);
+    TEST_EQUAL(LoadGpxFromString(content), expected, (prefix.size()));
+  }
+
+  // Files with no XML at all: no crash, and nothing is imported (empty data or an exception, as before).
+  for (std::string_view bad : {"", "\n  \n", "\xEF\xBB\xBF", "\xEF\xBB\xBF \n"})
+  {
+    kml::FileData data;
+    try
+    {
+      kml::DeserializerGpx(data).Deserialize(MemReader(bad));
+    }
+    catch (kml::DeserializerGpx::DeserializeException const &)
+    {
+    }
+    TEST(data.m_bookmarksData.empty() && data.m_tracksData.empty(), (bad.size()));
+  }
+}
+
+UNIT_TEST(Gpx_LeadingWhitespaceSize_Test)
+{
+  auto const size = [](std::string_view s) { return kml::GetXmlLeadingWhitespaceSize(MemReader(s)); };
+  TEST_EQUAL(size(""), 0, ());
+  TEST_EQUAL(size("<?xml"), 0, ());
+  TEST_EQUAL(size("\n<"), 1, ());
+  TEST_EQUAL(size(" \t\r\n<"), 4, ());
+  TEST_EQUAL(size("\xEF\xBB\xBF<"), 3, ());
+  TEST_EQUAL(size("\xEF\xBB\xBF\r\n<"), 5, ());
+  TEST_EQUAL(size("\xEF\xBB"), 0, ());  // Truncated BOM is not skipped.
+  TEST_EQUAL(size("\n\xEF\xBB\xBF<"), 1, ());  // Whitespace before a BOM: expat then accepts the BOM.
+  TEST_EQUAL(size("x <"), 0, ());          // Only leading bytes count.
+  TEST_EQUAL(size("   "), 3, ());          // All whitespace: everything is skipped, the parser then fails.
+  std::string big(1000, ' ');
+  big += "<";
+  TEST_EQUAL(size(big), 1000, ());  // More than one read chunk.
+}
