 #include <sstream>
 
 namespace kml
 {
 
+uint64_t GetXmlLeadingWhitespaceSize(Reader const & reader)
+{
+  uint64_t const size = reader.Size();
+  uint64_t pos = 0;
+  if (size >= 3)
+  {
+    unsigned char bom[3];
+    reader.Read(0, bom, 3);
+    if (bom[0] == 0xEF && bom[1] == 0xBB && bom[2] == 0xBF)
+      pos = 3;
+  }
+
+  char buf[64];
+  while (pos < size)
+  {
+    size_t const n = static_cast<size_t>(std::min<uint64_t>(sizeof(buf), size - pos));
+    reader.Read(pos, buf, n);
+    for (size_t i = 0; i < n; ++i)
+    {
+      char const c = buf[i];
+      if (c != ' ' && c != '\t' && c != '\r' && c != '\n')
+        return pos + i;
+    }
+    pos += n;
+  }
+  return pos;
+}
